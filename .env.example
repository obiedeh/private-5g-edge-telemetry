# Environment variables for private-5g-data-pipeline
# Copy to .env and fill in values. Never commit .env.

# Pipeline mode: synthetic | csv
# PIPELINE_MODE=synthetic

# Input directory for CSV telemetry (used when mode=csv)
# PIPELINE_INPUT_DIR=data/raw

# Output directory for Parquet and reports
# PIPELINE_OUTPUT_DIR=data/curated

# Config file path
# PIPELINE_CONFIG=configs/pipeline_config.yaml

# Fail-soft mode: continue pipeline on invalid rows (true | false)
# PIPELINE_FAIL_SOFT=true

# Deterministic seed for synthetic data generation
# PIPELINE_SEED=42
